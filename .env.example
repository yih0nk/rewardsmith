# Copy to .env and fill in. Never commit .env.
# The server and worker read .env from the folder they start in; exported variables win.
ANTHROPIC_API_KEY=
FACTORY_API_KEY=

# 1 = no GPU: fake training and metrics, so the UI and loop run on a laptop.
REWARDSMITH_FAKE_SIM=1
# 1 = no API calls: canned rewards and critiques.
REWARDSMITH_FAKE_LLM=1

REWARDSMITH_MODEL=claude-opus-5-5
REWARDSMITH_ENV=Go1JoystickFlatTerrain
REWARDSMITH_K=4
REWARDSMITH_ROUNDS=5
# The worker stops once a candidate scores this high (0-10). Set 11 for demos so every round runs.
REWARDSMITH_SUCCESS_SCORE=8
# Where the SQLite db and rendered videos live.
REWARDSMITH_HOME=.rewardsmith
# Who revises rewards from round 2 on: claude, or droid (needs FACTORY_API_KEY and the droid CLI).
REWARDSMITH_EDITOR=claude
# Optional Droid model id; empty uses Droid's default.
REWARDSMITH_DROID_MODEL=
